# Shreeja Finance Backend — environment variables
# Copy to .env and fill in values. Never commit .env.

# Server
PORT=4000
NODE_ENV=development          # development | production

# Supabase (service-role only — never expose to clients)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
JWT_SECRET=<supabase-jwt-secret>   # Project Settings → API → JWT Secret

# CDN
# Production: /var/www/skfinance/cdn
# Local dev:  ./cdn
CDN_BASE_DIR=./cdn
CDN_BASE_URL=http://localhost:4000/cdn

# OTP / SMS provider (O4 — TBD by client)
# In development, OTP stub accepts '999999' for any number.
SMS_PROVIDER=stub              # stub | msg91 | twofactor
SMS_API_KEY=

# App
APP_NO_PREFIX=SF               # application_no prefix e.g. SF-2026-00001
